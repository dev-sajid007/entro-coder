{
  "name": "entro-coder",
  "version": "0.1.0",
  "description": "A lightweight, terminal-first AI coding agent",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "entro": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
