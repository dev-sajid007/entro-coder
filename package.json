    "dotenv": "^16.4.0",
    "openai": "^4.78.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "undici": "^7.0.0",
    "vitest": "^3.0.0"
  }
